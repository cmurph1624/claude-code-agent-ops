[Unit]
Description=Automated PR reviewer (agent-ops/review)

[Service]
Type=oneshot
WorkingDirectory=%h/dev/agent-ops
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/dev/agent-ops/review/review_poller.py
# A review takes 1-3 min; several queued PRs run serially in one invocation.
TimeoutStartSec=90min
Nice=5
